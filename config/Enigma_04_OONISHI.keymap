#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    // zmk-listeners

    layer_listeners {
        compatible = "zmk,layer-listeners";

        release_ctrl {
            layers = <6>;
            bindings = <&kt_on LCTRL &kt_off LCTRL>;
        };

        release_shift {
            layers = <7>;
            bindings = <&kt_on LEFT_SHIFT &kt_off LEFT_SHIFT>;
        };

        release_win {
            layers = <8>;
            bindings = <&kt_on LEFT_WIN &kt_off LEFT_WIN>;
        };

        release_alt {
            layers = <9>;
            bindings = <&kt_on LEFT_ALT &kt_off LEFT_ALT>;
        };
    };

    macros {
        // zmk-listeners
        // zmk-listeners

        ya_macro: ya_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp A>;
            label = "YA_MACRO";
        };

        yu_macro: yu_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp U>;
            label = "YU_MACRO";
        };

        yo_macro: yo_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp O>;
            label = "YO_MACRO";
        };

        M0_macro: M0_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_4 &kp N0 &kp NUMBER_1 &kp NUMBER_3 &kp LS(Y) &kp O &kp I &kp O &kp M &kp LS(I)>;
            label = "M0_MACRO";
        };

        M6_macro: M6_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(U) &kp NUMBER_3 &kp NUMBER_1 &kp N9 &kp N8 &kp NUMBER_1 &kp NUMBER_2 &kp TAB>;
            label = "M6_MACRO";
        };

        M1_macro: M1_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RIGHT_BRACKET>;
            label = "M1_MACRO";
        };

        M2_macro: M2_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS>;
            label = "M2_MACRO";
        };
    };

    behaviors {
        // Layout shift

        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        // Layout shift

        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };

        // zmk-listeners

        kt_on: key_toggle_on_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle On";
            toggle-mode = "on";
        };

        // zmk-listeners

        kt_off: key_toggle_off_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key Toggle Off";
            toggle-mode = "off";
        };

        // zmk-listeners

        lt_to_0: lt_to_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_to_0";
            bindings = <&mo_to_0>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
        };

        // rotary encoder

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <50>;
        };

        // rotary encoder

        scroll_left_right: mouse_wheel_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <50>;
        };

        // rotary encoder

        arrow_left_right: arrow_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp RIGHT>;

            tap-ms = <50>;
        };

        // rotary encoder

        arrow_up_down: arrow_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp UP>, <&kp DOWN>;

            tap-ms = <50>;
        };

        // rotary encoder

        page_up_down: page_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp PAGE_UP>, <&kp PAGE_DOWN>;

            tap-ms = <50>;
        };

        td1: td_hz_mo_kn {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_HZ_MO_KN";
            #binding-cells = <0>;
            bindings = <&lt 9 TILDE>;
        };

        td2: td_f7_mo_f8 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F7_MO_F8";
            #binding-cells = <0>;
            bindings = <&lt 9 F7>, <&kp F8>;
        };

        td3: td_space_mo_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SPACE_MO_SLASH";
            #binding-cells = <0>;
            bindings = <&lt 1 SPACE>, <&kp SLASH>;
        };

        td4: coron_semicoron {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COLON_SEMICOLON";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMICOLON>;
        };

        Ctl: td_ctrl_toctrl {
            compatible = "zmk,behavior-tap-dance";
            label = "td_CTRL_TOCTRL";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&mo 6>;
        };

        WIN: td_win_towin {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_WIN_TOWIN";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN>, <&mo 8>;
        };

        Sft: td_shift_toshift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFT_TOSHIFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&mo 7>;
        };

        ALT: td_alt_toalt {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_TOALT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&mo 9>;
        };
    };

    combos {
        compatible = "zmk,combos";

        c1 {
            bindings = <&kp LC(C)>;
            key-positions = <9 10>;
            layers = <0>;
        };

        c2 {
            bindings = <&kp LC(V)>;
            key-positions = <10 11>;
            layers = <0>;
        };

        c3 {
            bindings = <&kp LC(X)>;
            key-positions = <9 11>;
            layers = <0>;
        };

        c4 {
            bindings = <&kp LC(Z)>;
            key-positions = <9 10 11>;
            layers = <0>;
        };

        c5 {
            bindings = <&kp H>;
            key-positions = <14 6>;
            layers = <0>;
        };

        c6 {
            bindings = <&kp P>;
            key-positions = <14 7>;
            layers = <0>;
        };

        c7 {
            bindings = <&kp B>;
            key-positions = <14 26>;
            layers = <0>;
        };

        c8 {
            bindings = <&kp PLUS>;
            key-positions = <14 15>;
            layers = <1>;
        };

        c9 {
            bindings = <&kp MINUS>;
            key-positions = <15 16>;
            layers = <1>;
        };

        c10 {
            bindings = <&kp SLASH>;
            key-positions = <24 25>;
            layers = <1>;
        };

        c11 {
            bindings = <&kp ASTERISK>;
            key-positions = <25 26>;
            layers = <1>;
        };

        c12 {
            bindings = <&kp Q>;
            key-positions = <19 20>;
            layers = <0>;
        };

        c13 {
            bindings = <&kp C>;
            key-positions = <20 21>;
            layers = <0>;
        };

        c14 {
            bindings = <&kp L>;
            key-positions = <19 21>;
            layers = <0>;
        };

        c15 {
            bindings = <&kp V>;
            key-positions = <19 20 21>;
            layers = <0>;
        };

        c16 {
            bindings = <&kp COMMA>;
            key-positions = <14 15>;
            layers = <0>;
        };

        c17 {
            bindings = <&kp PERIOD>;
            key-positions = <15 16>;
            layers = <0>;
        };

        c18 {
            bindings = <&kp G>;
            key-positions = <23 14>;
            layers = <0>;
        };

        c19 {
            bindings = <&kp D>;
            key-positions = <24 15>;
            layers = <0>;
        };

        c20 {
            bindings = <&ya_macro>;
            key-positions = <22 11>;
            layers = <0>;
        };

        c21 {
            bindings = <&kp X>;
            key-positions = <21 10>;
            layers = <0>;
        };

        c22 {
            bindings = <&kp TAB>;
            key-positions = <21 22>;
            layers = <0>;
        };

        c23 {
            bindings = <&kp DEL>;
            key-positions = <6 7>;
            layers = <0>;
        };

        c24 {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <0 1>;
            layers = <1>;
        };

        c25 {
            bindings = <&kp PERCENT>;
            key-positions = <1 2>;
            layers = <1>;
        };

        c26 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <0 1>;
            layers = <0>;
        };

        c27 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <1 2>;
            layers = <0>;
        };

        c28 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <0 2>;
            layers = <0>;
        };

        c29 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <0 1 2>;
            layers = <0>;
        };

        c30 {
            bindings = <&kp COLON>;
            key-positions = <2 3>;
            layers = <0>;
        };

        c31 {
            bindings = <&kp HASH>;
            key-positions = <11 12>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
       &kp U    &kp E           &kp MINUS            &yo_macro             &kp F        &kp W            &kp R  &kp Y
&none  &kp A    &kp I           &kp O                &yu_macro             &kp K        &kp T            &kp N  &kp S  &none
&none  &kp ESC  &mt LEFT_ALT Z  &mt LS(SPACE) LCTRL  &mt LEFT_SHIFT SPACE  &lt 1 ENTER  &lt 2 BACKSPACE  &kp M  &kp J  &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        tenkey {
            bindings = <
       &kp AMPS  &kp CARET  &kp DQT    &kp DLLR          &kp KP_N0  &kp KP_N7  &kp KP_N8  &kp KP_N9
&none  &kp AT    &kp PIPE   &kp GRAVE  &kp SINGLE_QUOTE  &kp EQUAL  &kp KP_N4  &kp KP_N5  &kp KP_N6  &none
&none  &kp EXCL  &kp FSLH   &kp QMARK  &kp TILDE         &none      &kp KP_N1  &kp KP_N2  &kp KP_N3  &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        cursor {
            bindings = <
       &kp F7  &kp F8  &kp F9  &kp LC(LA(DEL))  &none  &none     &kp UP_ARROW  &none
&none  &kp F4  &kp F5  &kp F6  &M6_macro        &none  &kp LEFT  &kp DOWN      &kp RIGHT  &none
&none  &kp F1  &kp F2  &kp F3  &M0_macro        &none  &none     &none         &none      &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        symbol {
            bindings = <
            &none       &none       &none       &none       &kp F1  &kp F2   &kp F3   &kp F4
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp F5  &kp F6   &kp F7   &kp F8   &none
&kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &kp F9  &kp F10  &kp F11  &kp F12  &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        macro {
            bindings = <
       &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        setting {
            bindings = <
              &bt BT_CLR    &none         &bt BT_CLR_ALL  &none         &none  &none  &none  &none
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &none  &none  &none  &none       &none
&bootloader   &sys_reset    &none         &none           &none         &none  &none  &none  &sys_reset  &bootloader
            >;
        };

        to_CTRL {
            bindings = <
       &kp LS(TAB)  &kp UP    &kp TAB    &none  &none  &kp HOME  &kp PAGE_UP    &none
&none  &kp LEFT     &kp DOWN  &kp RIGHT  &none  &none  &kp END   &kp PAGE_DOWN  &kp UP    &none
&none  &none        &none     &none      &none  &none  &none     &kp LEFT       &kp DOWN  &kp RIGHT
            >;
        };

        to_SHIFT {
            bindings = <
       &none     &kp UP    &none      &none  &none  &kp HOME  &kp PAGE_UP    &none
&none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none  &kp END   &kp PAGE_DOWN  &kp UP    &none
&none  &none     &none     &none      &none  &none  &none     &kp LEFT       &kp DOWN  &kp RIGHT
            >;
        };

        to_WIN {
            bindings = <
       &kp LS(TAB)  &kp UP    &kp TAB    &none  &none  &kp HOME  &kp PAGE_UP    &none
&none  &kp LEFT     &kp DOWN  &kp RIGHT  &none  &none  &kp END   &kp PAGE_DOWN  &kp UP    &none
&none  &none        &none     &none      &none  &none  &none     &kp LEFT       &kp DOWN  &kp RIGHT
            >;
        };

        to_ALT {
            bindings = <
       &kp LS(TAB)  &kp UP    &kp TAB    &none  &none  &kp HOME  &kp PAGE_UP    &kp PRINTSCREEN
&none  &kp LEFT     &kp DOWN  &kp RIGHT  &none  &none  &kp END   &kp PAGE_DOWN  &kp UP           &none
&none  &none        &none     &none      &none  &none  &none     &kp LEFT       &kp DOWN         &kp RIGHT
            >;
        };
    };
};
